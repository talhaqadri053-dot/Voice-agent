      "parameters": {
        "jsCode": "const input=$input.first().json;const body=input.body ?? input;const message=body.message ?? body;const artifact=message.artifact ?? body.artifact ?? {};const call=message.call ?? body.call ?? {};const startedAt=call.startedAt ?? call.started_at ?? body.callStartedAt ?? null;const endedAt=call.endedAt ?? call.ended_at ?? body.callEndedAt ?? null;const rawDuration=message.durationSeconds ?? call.durationSeconds ?? body.durationSeconds ?? null;const duration=rawDuration===null||rawDuration===undefined?null:Math.max(0,Math.round(Number(rawDuration)));const transcript=String(artifact.transcript ?? body.transcript ?? '').trim();const transcriptMessages=Array.isArray(artifact.messages)?artifact.messages.map((entry,index)=>({role:String(entry.role ?? entry.speaker ?? '').toLowerCase().includes('assistant')?'assistant':String(entry.role ?? entry.speaker ?? '').toLowerCase().includes('user')?'user':'',text:String(entry.message ?? entry.content ?? entry.text ?? '').trim(),timestamp:entry.timestamp ?? entry.ts ?? null,turn:index + 1})):[];const vapiCallId=String(call.id ?? message.callId ?? body.callId ?? '').trim();const phone=String(call.customer?.number ?? body.call?.customer?.number ?? body.phone ?? '').trim() || null;const recordingUrl=String(message.recordingUrl ?? artifact.recordingUrl ?? body.recordingUrl ?? '').trim() || null;const summary=String(message.analysis?.summary ?? body.summary ?? '').trim();const turnMetrics=Array.isArray(artifact.messages)?artifact.messages.map((entry,index)=>{const metrics=entry.metrics ?? entry.metadata ?? {};const read=(keys)=>{for(const key of keys){const value=metrics[key] ?? entry[key];if(value!==null&&value!==undefined&&value!==''&&Number.isFinite(Number(value)))return Math.round(Number(value));}return null};const stt=read(['sttLatencyMs','stt_latency_ms','sttLatency','stt_latency']);const llm=read(['llmLatencyMs','llm_latency_ms','llmLatency','llm_latency']);const tts=read(['ttsLatencyMs','tts_latency_ms','ttsLatency','tts_latency']);const total=read(['totalLatencyMs','total_latency_ms','totalLatency','total_latency']);return {turn:index + 1,stt_ms:stt,llm_ms:llm,tts_ms:tts,total_ms:total ?? (stt !== null && llm !== null && tts !== null ? stt + llm + tts : null)};}):[];return [{json:{vapi_call_id:vapiCallId,phone:phone,transcript:transcript,transcript_messages:transcriptMessages,recording_url:recordingUrl,summary:summary,duration_seconds:duration,call_started_at:startedAt,call_ended_at:endedAt,turn_metrics:turnMetrics}}];"
