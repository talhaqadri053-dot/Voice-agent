      "parameters": {
        "jsCode": "const d=$input.first().json;if(d?.error||d?.statusCode>=400)return [{json:{saveFailed:true}}];if(d?.ok!==true)return [{json:{saveFailed:true}}];const items=Array.isArray(d.order?.items)?d.order.items.map(x=>`${x.quantity}x ${x.name}`).join(', '):'';const business=String($('Config').first().json.business_name || 'YOUR_BUSINESS_NAME').trim() || 'YOUR_BUSINESS_NAME';let body='';if(d.order){body=`${business}: ${items || 'Bestelling ontvangen'}. Totaal EUR ${Number(d.order.total??0).toFixed(2).replace('.', ',')}. ${d.order.order_type==='delivery'?'Bezorgen':'Afhalen'} ca. ${d.order.eta_minutes ?? '?'} min.`;} else if(d.booking){body=`${business}: Reservering ${d.booking.service ?? ''} ${String(d.booking.date ?? '').slice(0,10)} ${String(d.booking.time ?? '').slice(0,5)} ${d.booking.people_count ?? ''} pers.`;} return [{json:{call_id:d.call_id,phone:d.phone,sms_status:d.sms_status,shouldSend:!!(d.order||d.booking)&&d.sms_status!=='sent'&&!d.duplicate&&!!d.phone,smsBody:body.slice(0,160),twilioFrom:$('Config').first().json.twilio_from || 'YOUR_TWILIO_SENDER_ID',saveFailed:false}}];"
